{
	"name": "@muxmuxmux/machine",
	"version": "0.1.0",
	"type": "module",
	"description": "State machines whose states own their work, and leaving a state aborts it",
	"keywords": [
		"state",
		"typescript",
		"observable",
		"state-machine",
		"framework-agnostic",
		"react",
		"svelte"
	],
	"author": "Vadim Kotov",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/vadirn/muxmuxmux.git",
		"directory": "packages/machine"
	},
	"homepage": "https://github.com/vadirn/muxmuxmux#readme",
	"bugs": {
		"url": "https://github.com/vadirn/muxmuxmux/issues"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./react": {
			"import": {
				"types": "./dist/react.d.ts",
				"default": "./dist/react.js"
			}
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "tsc --project tsconfig.build.json --watch",
		"typecheck": "tsc --noEmit && tsc --project fixtures/declaration-emit",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"size": "npm pack --dry-run",
		"clean": "rm -rf dist *.tsbuildinfo"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"jsdom": "^30.1.3",
		"react": "^19.3.1",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	}
}
