{
	"name": "@muxmuxmux/core",
	"version": "0.2.0",
	"type": "module",
	"description": "Typesafe state-dependent behavior for modern apps",
	"keywords": [
		"state",
		"typescript",
		"observable",
		"state-machine",
		"framework-agnostic",
		"state-controller",
		"tanstack-intent"
	],
	"author": "Vadim Kotov",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/vadirn/muxmuxmux.git",
		"directory": "packages/core"
	},
	"homepage": "https://github.com/vadirn/muxmuxmux#readme",
	"bugs": {
		"url": "https://github.com/vadirn/muxmuxmux/issues"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"files": [
		"dist",
		"skills"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "tsc --project tsconfig.build.json --watch",
		"typecheck": "tsc --noEmit && tsc --project fixtures/declaration-emit",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"size": "npm pack --dry-run",
		"clean": "rm -rf dist *.tsbuildinfo"
	},
	"devDependencies": {
		"happy-dom": "21.0.4",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	}
}
